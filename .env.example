# Public frontend configuration. Safe to set in Vercel Preview/Production.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_ADMIN_EMAIL=admin@example.com

# Server-only variables. Never prefix these with VITE_ and never expose them to the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
RESEND_API_KEY=replace-with-resend-key
RESEND_FROM_EMAIL=verified@example.com
BACKUP_FROM_EMAIL=verified@example.com
BACKUP_CRON_TOKEN=replace-with-random-token